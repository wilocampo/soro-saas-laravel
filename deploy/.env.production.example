# Single-tenant production template (docs/specs/10 §7).
# Copy to `.env` at the repo root, fill in, then run:
#   docker compose -f deploy/docker-compose.yml exec app php artisan app:production-check

APP_NAME=Soro
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false               # stack traces leak TINs and payloads
APP_URL=https://books.example.ph   # must be https (RMC 5-2021 Annex B item 11)

# Entry dates decide fiscal periods and BIR deadlines (D18). Do not change.
APP_TIMEZONE=Asia/Manila

# One client, one install: public registration is disabled and billing is
# by contract rather than by card.
SINGLE_TENANT=true
BILLING_ENABLED=false

APP_PORT=8080

# --- database (D22: MariaDB 11.8, floor 10.5) ------------------------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_MARIADB_DATABASE=soro
DB_USERNAME=soro
DB_PASSWORD=
DB_ROOT_PASSWORD=

# The APP user must NOT hold ALL PRIVILEGES. After first migrate, run:
#   REVOKE UPDATE, DELETE ON soro.audit_log FROM 'soro'@'%';
#   GRANT INSERT, SELECT ON soro.audit_log TO 'soro'@'%';
# The append-only audit trail rests on privileges as well as triggers,
# because a trigger can be dropped by whoever is allowed to drop it
# (CLAUDE.md #8). `app:production-check` warns if this was skipped.

# --- compliance ------------------------------------------------------------
# Printed in the mandatory header/footer of every book and report
# (RMC 5-2021 Annex B item 4). Bump the version each release.
COMPLIANCE_SOFTWARE_NAME=Soro
COMPLIANCE_SOFTWARE_VERSION=1.0.0

# --- privacy ---------------------------------------------------------------
# Telescope records request payloads: credentials in flight, TINs, whole
# invoices. Leaving it on in production is a DPA hazard (RA 10173).
TELESCOPE_ENABLED=false

# --- mail (invoice delivery) ----------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=billing@example.ph
MAIL_FROM_NAME="${APP_NAME}"

# --- queue and cache -------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# --- backups (spec 10 §1) --------------------------------------------------
# Keep a readable, PH-resident copy of the books (RR 9-2009 §6). The
# scheduler runs tenants:backup nightly into /backups; ship it off-box.
BACKUP_KEEP_DAYS=30
